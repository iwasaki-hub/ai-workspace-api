<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="AI Workspace API の標準OpenAPI仕様をSwagger UIで表示します。">
  <meta name="theme-color" content="#101c30">
  <title>Swagger UI | AI Workspace API</title>
  <link rel="stylesheet" href="/swagger-assets/swagger-ui.css">
  <link rel="stylesheet" href="/css/swagger-page.css">
  <script src="/swagger-assets/swagger-ui-bundle.js" defer></script>
  <script src="/js/swagger-init.js" defer></script>
</head>
<body>
  <header class="swagger-header">
    <a href="/" aria-label="AI Workspace APIのホームに戻る">← AI Workspace API</a>
    <span>OpenAPI 3.1 / Swagger UI</span>
  </header>
  <div class="swagger-banner">GETのみ公開しています。Swagger UIから実行してもデータは変更されません。</div>
  <main id="swagger-ui" aria-label="API仕様一覧">
    <p class="swagger-loading">OpenAPI仕様書を読み込んでいます…</p>
  </main>
</body>
</html>
