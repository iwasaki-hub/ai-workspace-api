{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Workspace API",
    "version": "0.11.0",
    "summary": "Read-only demo REST API",
    "description": "MongoDB Atlasから `demo: true` のレコードのみを読み取る学習用公開REST API。書き込みAPIは提供しません。`/health` はMongoDBの接続検証を行いません。"
  },
  "servers": [
    {
      "url": "/",
      "description": "現在のホスト（Renderまたはローカル）"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "稼働確認"
    },
    {
      "name": "Users",
      "description": "デモデータ取得"
    },
    {
      "name": "Todos",
      "description": "公開デモToDoの取得"
    },
    {
      "name": "Statistics",
      "description": "API利用状況（書き込み不可）"
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "サーバー稼働確認",
        "description": "MongoDBへはアクセスしません。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "ai-workspace-api"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "operationId": "listDemoUsers",
        "tags": [
          "Users"
        ],
        "summary": "公開デモユーザー一覧取得",
        "description": "`demo: true` のレコードを `_id` 昇順で最大50件返します。空の配列の場合もあります。\n\nHTTP 429のレート制限対象（クライアントごとに120回/分、インスタンス単位）。",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "active/inactiveを指定。重複して指定した場合は400を返します。",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            },
            "example": "active"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/components/schemas/DemoUser"
                  }
                },
                "example": [
                  {
                    "id": "6afaa9fb021f207d9648f5ad",
                    "name": "デモ太郎",
                    "status": "active",
                    "purpose": "接続テスト"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "statusが不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "invalid_status",
                  "message": "statusにはactiveまたはinactiveを指定してください。"
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "operationId": "getDemoUserById",
        "tags": [
          "Users"
        ],
        "summary": "ObjectIdによるデモユーザーの取得",
        "description": "一致するObjectIdを持ち、`demo: true` のレコードのみ返します。\n\nHTTP 429のレート制限対象（クライアントごとに120回/分、インスタンス単位）。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "24桁の16進数のMongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$"
            },
            "example": "6afaa9fb021f207d9648f5ad"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoUser"
                },
                "example": {
                  "id": "6afaa9fb021f207d9648f5ad",
                  "name": "デモ太郎",
                  "status": "active",
                  "purpose": "接続テスト"
                }
              }
            }
          },
          "400": {
            "description": "IDの形式が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "invalid_id",
                  "message": "IDは24桁の16進数で指定してください。"
                }
              }
            }
          },
          "404": {
            "description": "公開データが見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "not_found",
                  "message": "指定されたデータは見つかりませんでした。"
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/todos": {
      "get": {
        "operationId": "listDemoTodos",
        "tags": [
          "Todos"
        ],
        "summary": "公開デモToDo一覧取得",
        "description": "`ai_workspace_db.todos`の`demo: true`のみを`_id`昇順で最大50件返します。読み取り専用。HTTP 429のレート制限対象。",
        "responses": {
          "200": {
            "description": "公開デモToDo一覧（最大50件）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/components/schemas/DemoTodo"
                  }
                },
                "example": [
                  {
                    "id": "6afaa9fb021f207d9648f5b1",
                    "title": "APIの仕様書を確認する",
                    "completed": true
                  }
                ]
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "operationId": "getDemoTodoById",
        "tags": [
          "Todos"
        ],
        "summary": "ObjectIdによる公開デモToDo取得",
        "description": "`demo: true`の一致するレコードを1件取得します。読み取り専用。HTTP 429のレート制限対象。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "24桁の16進数のMongoDB ObjectId",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$"
            },
            "example": "6afaa9fb021f207d9648f5b1"
          }
        ],
        "responses": {
          "200": {
            "description": "公開デモToDo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoTodo"
                },
                "example": {
                  "id": "6afaa9fb021f207d9648f5b1",
                  "title": "APIの仕様書を確認する",
                  "completed": true
                }
              }
            }
          },
          "400": {
            "description": "IDの形式が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "invalid_id",
                  "message": "IDは24桁の16進数で指定してください。"
                }
              }
            }
          },
          "404": {
            "description": "公開データが見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "not_found",
                  "message": "指定されたデータは見つかりませんでした。"
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "operationId": "getApiStatistics",
        "tags": [
          "Statistics"
        ],
        "summary": "API利用状況（集計開始後の累計）",
        "description": "公開Users/TodosのGETリクエストを、MongoDBに保存された運用カウンターから取得します。集計開始以前や429などレート制限で拒否されたリクエスト、ヘルスチェック、統計取得自身は含みません。値は運用上の参考値であり、厳密な課金・請求用ではありません。",
        "responses": {
          "200": {
            "description": "累計リクエストと集計開始日時",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatistics"
                },
                "example": {
                  "totalRequests": 0,
                  "startedAt": "2026-11-16T11:00:00.000Z"
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/details": {
      "get": {
        "operationId": "getDetailedApiStatistics",
        "tags": [
          "Statistics"
        ],
        "summary": "日別・月別・API別のアクセス統計",
        "description": "日本時間（JST）で今日と今月の件数、および直近7日間・公開GET API4ルートの利用回数を返します。既存の累計は従来の記録から引き継ぎますが、日別・月別・API別の内訳は詳細集計機能の公開後から記録し、過去の内訳を推測して補完しません。HTTP 429や統計取得自身はカウント対象外。MongoDBの1回の原子的$incでカウンターを更新するベストエフォート方式です。",
        "responses": {
          "200": {
            "description": "日本時間基準の集計済みリクエスト数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedApiStatistics"
                },
                "example": {
                  "totalRequests": 125,
                  "todayRequests": 8,
                  "monthRequests": 20,
                  "date": "2026-11-17",
                  "month": "2026-11",
                  "timezone": "Asia/Tokyo",
                  "startedAt": "2026-11-16T11:30:30.791Z",
                  "last7Days": [
                    {
                      "date": "2026-11-11",
                      "requests": 0
                    },
                    {
                      "date": "2026-11-12",
                      "requests": 0
                    },
                    {
                      "date": "2026-11-13",
                      "requests": 0
                    },
                    {
                      "date": "2026-11-14",
                      "requests": 0
                    },
                    {
                      "date": "2026-11-15",
                      "requests": 0
                    },
                    {
                      "date": "2026-11-16",
                      "requests": 12
                    },
                    {
                      "date": "2026-11-17",
                      "requests": 8
                    }
                  ],
                  "endpoints": [
                    {
                      "path": "GET /api/users",
                      "requests": 12
                    },
                    {
                      "path": "GET /api/users/:id",
                      "requests": 2
                    },
                    {
                      "path": "GET /api/todos",
                      "requests": 12
                    },
                    {
                      "path": "GET /api/todos/:id",
                      "requests": 2
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/visitors": {
      "get": {
        "operationId": "getUniqueBrowserVisitors",
        "tags": [
          "Statistics"
        ],
        "summary": "同意済みWebブラウザの推定ユニーク数",
        "description": "今日・今月（Asia/Tokyo）の計測同意済みブラウザ数のみを集計します。ログインユーザーの人数ではなく、同じ人の複数端末・ブラウザは別カウントです。過去の履歴は遡及計測しません。生の識別子やIPはMongoDBに保存せず、期間別のハッシュを期限付きで保持します。",
        "responses": {
          "200": {
            "description": "同意済みブラウザのユニーク件数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsiteVisitorStatistics"
                }
              }
            }
          },
          "429": {
            "description": "レート制限（同じクライアントから60秒間に120回を超えるAPIリクエスト）",
            "headers": {
              "Retry-After": {
                "description": "再試行までの待機秒数",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "rate_limited",
                  "message": "リクエストが集中しています。時間をおいて再試行してください。"
                }
              }
            }
          },
          "503": {
            "description": "DB設定不足または読み取り失敗",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": "service_unavailable",
                  "message": "データを取得できませんでした。時間をおいて再試行してください。"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "ai-workspace-api"
          }
        }
      },
      "DemoUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "description": "MongoDB ObjectIdの文字列表現"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "active",
              "inactive",
              null
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "DemoTodo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "completed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "description": "MongoDB ObjectIdの文字列表現"
          },
          "title": {
            "type": "string",
            "description": "ToDoの内容"
          },
          "completed": {
            "type": "boolean",
            "description": "完了状態"
          }
        }
      },
      "ApiStatistics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "totalRequests",
          "startedAt"
        ],
        "properties": {
          "totalRequests": {
            "type": "integer",
            "minimum": 0,
            "description": "集計開始後の公開GET API累計（ベストエフォート）"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "集計開始時刻（UTC）"
          }
        }
      },
      "DetailedApiStatistics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "totalRequests",
          "todayRequests",
          "monthRequests",
          "date",
          "month",
          "timezone",
          "startedAt",
          "last7Days",
          "endpoints"
        ],
        "properties": {
          "totalRequests": {
            "type": "integer",
            "minimum": 0,
            "description": "既存の累計カウンターを継承"
          },
          "todayRequests": {
            "type": "integer",
            "minimum": 0
          },
          "monthRequests": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
